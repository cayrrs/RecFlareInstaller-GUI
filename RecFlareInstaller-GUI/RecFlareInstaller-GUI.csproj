<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>RecFlareInstaller_GUI</RootNamespace>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Compile Update="WelcomePage.cs">
        <SubType>UserControl</SubType>
      </Compile>
      <Compile Update="InstallationPage.cs">
        <SubType>UserControl</SubType>
      </Compile>
      <Compile Update="CompletePage.cs">
        <SubType>UserControl</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ini-parser-netstandard" Version="2.5.3" />
      <PackageReference Include="Octokit" Version="14.0.0" />
    </ItemGroup>

</Project>